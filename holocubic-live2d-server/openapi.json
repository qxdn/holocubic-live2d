{
  "openapi": "3.1.0",
  "info": {
    "title": "HoloCubic Live2D API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Live2dModelPageResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Live2dModel"
            }
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      },
      "Live2dModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "motions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Live2dMotion"
            }
          }
        },
        "required": ["id", "name", "url", "motions"]
      },
      "Live2dMotion": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        },
        "required": ["name", "desc"]
      },
      "Live2dModelResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Live2dModel"
              },
              {
                "type": ["object", "null"]
              }
            ]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      },
      "AsrResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "type": ["object", "null"],
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": ["text"]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "tags": ["Chat"],
        "summary": "与指定 Agent 对话，返回 AI SDK UI message 流",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "characterId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  }
                },
                "required": ["characterId", "messages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI SDK UI message SSE 流。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/live2d/page": {
      "get": {
        "operationId": "pageLive2dModels",
        "tags": ["Live2D"],
        "summary": "分页获取可用的 Live2D 模型",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 20
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "统一业务响应，data 为模型分页结果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live2dModelPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/live2d/model/{id}": {
      "get": {
        "operationId": "getLive2dModel",
        "tags": ["Live2D"],
        "summary": "按 ID 获取 Live2D 模型",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "统一业务响应，data 为模型信息，未找到时为 null。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live2dModelResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/speech/asr": {
      "post": {
        "operationId": "transcribeAudio",
        "tags": ["Speech"],
        "summary": "提交完整 PCM 音频并返回识别文本",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "characterId",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "16 kHz、单声道、16-bit 小端裸 PCM，不含 WAV 文件头。"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "统一业务响应，data.text 为最终文本；失败时返回统一业务错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsrResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/speech/stream": {
      "get": {
        "operationId": "streamSpeechForVad",
        "tags": ["Speech"],
        "summary": "建立实时语音 WebSocket 会话",
        "description": "连接后持续发送 16 kHz、单声道、16-bit 小端 PCM 二进制帧。服务端使用 Silero VAD 检测语句边界，静音约 700 ms 后通过 WebSocket 返回最终识别文本。连接查询参数 characterId 选择 Character 及其 ASR 配置。",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "characterId",
            "in": "query"
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket 握手成功；后续消息遵循语音流协议。"
          },
          "400": {
            "description": "缺少或无效的 characterId。"
          }
        }
      }
    },
    "/api/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "tags": ["OpenAI Compatible"],
        "summary": "OpenAI Chat Completions compatible endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["system", "user", "assistant"]
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": ["role", "content"]
                    },
                    "minItems": 1
                  },
                  "stream": {
                    "type": "boolean"
                  }
                },
                "required": ["model", "messages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion or server-sent event stream.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "enum": ["chat.completion"]
                    },
                    "created": {
                      "type": "number"
                    },
                    "model": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "items": {}
                    }
                  },
                  "required": ["id", "object", "created", "model", "choices"]
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
