{
  "openapi": "3.1.0",
  "info": {
    "title": "HoloCubic Live2D API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "GreetingResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "type": ["object", "null"],
            "properties": {
              "greeting": {
                "type": "string"
              }
            },
            "required": ["greeting"]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      },
      "Live2dModelPageResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Live2dModel"
            }
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      },
      "Live2dModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "motions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Live2dMotion"
            }
          }
        },
        "required": ["id", "name", "url", "motions"]
      },
      "Live2dMotion": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        },
        "required": ["name", "desc"]
      },
      "Live2dModelResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Live2dModel"
              },
              {
                "type": ["object", "null"]
              }
            ]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api": {
      "get": {
        "operationId": "getGreeting",
        "tags": ["Greeting"],
        "summary": "获取服务问候信息",
        "responses": {
          "200": {
            "description": "统一业务响应，success 表示业务是否成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "tags": ["Chat"],
        "summary": "与测试 Agent 对话，返回 AI SDK UI message 流",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "modelId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  }
                },
                "required": ["modelId", "messages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI SDK UI message SSE 流。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/live2d/page": {
      "get": {
        "operationId": "pageLive2dModels",
        "tags": ["Live2D"],
        "summary": "分页获取可用的 Live2D 模型",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 20
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "统一业务响应，data 为模型分页结果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live2dModelPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/live2d/model/{id}": {
      "get": {
        "operationId": "getLive2dModel",
        "tags": ["Live2D"],
        "summary": "按 ID 获取 Live2D 模型",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "统一业务响应，data 为模型信息，未找到时为 null。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live2dModelResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
