OTEL_SERVICE_NAME=holocubic-live2d-server

# Upstream protocol used by both public endpoints: openai or anthropic.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Anthropic base URL includes /v1, not /messages.
# Kimi Code with AI SDK: https://api.kimi.com/coding/v1
# AI SDK appends /messages; unlike Anthropic's SDK, it does not append /v1/messages.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
# OTLP HTTP/JSON base URL; exporters append /v1/traces and /v1/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional authentication: key=value,key2=value2 (do not commit real credentials).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-token
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# OTEL_SDK_DISABLED=true
