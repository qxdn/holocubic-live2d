{
  "openapi": "3.1.0",
  "info": {
    "title": "HoloCubic Live2D API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "GreetingResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": ["object", "null"],
            "properties": {
              "greeting": {
                "type": "string"
              }
            },
            "required": ["greeting"]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      },
      "ChatCompletion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "enum": ["chat.completion"]
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["assistant"]
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["role", "content"]
                },
                "finish_reason": {
                  "type": "string",
                  "enum": ["stop", "length"]
                }
              },
              "required": ["index", "message", "finish_reason"]
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "completion_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["prompt_tokens", "completion_tokens", "total_tokens"]
          }
        },
        "required": ["id", "object", "created", "model", "choices", "usage"]
      },
      "OpenAIError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["invalid_request_error", "api_error"]
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "null"
              },
              "code": {
                "type": "null"
              }
            },
            "required": ["type", "message", "param", "code"]
          }
        },
        "required": ["error"]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["message"]
          },
          "role": {
            "type": "string",
            "enum": ["assistant"]
          },
          "model": {
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["text"]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": ["type", "text"]
            }
          },
          "stop_reason": {
            "type": "string",
            "enum": ["end_turn", "max_tokens"]
          },
          "stop_sequence": {
            "type": "null"
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["input_tokens", "output_tokens"]
          }
        },
        "required": [
          "id",
          "type",
          "role",
          "model",
          "content",
          "stop_reason",
          "stop_sequence",
          "usage"
        ]
      },
      "AnthropicError": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["error"]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["invalid_request_error", "api_error"]
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["type", "message"]
          }
        },
        "required": ["type", "error"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api": {
      "get": {
        "operationId": "getGreeting",
        "tags": ["Greeting"],
        "summary": "获取服务问候信息",
        "responses": {
          "200": {
            "description": "统一业务响应，success 表示业务是否成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "tags": ["AI"],
        "summary": "OpenAI 兼容文本对话",
        "description": "文本协议子集。stream=true 返回 SSE，以 [DONE] 结束；流内错误通过 error 数据返回。上游密钥由服务端配置，客户端无需认证。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["system", "user", "assistant"]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["role", "content"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "max_completion_tokens": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "stop": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxItems": 4
                      }
                    ]
                  }
                },
                "required": ["model", "messages"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "非流式 JSON 或 stream=true 时的 SSE。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 事件流；每个事件的数据为协议 JSON，具体事件及结束标记见接口说明。"
                }
              }
            }
          },
          "400": {
            "description": "JSON 解析失败或请求字段不合法。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "502": {
            "description": "上游请求失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages": {
      "post": {
        "operationId": "createMessage",
        "tags": ["AI"],
        "summary": "Anthropic 兼容文本对话",
        "description": "文本协议子集。stream=true 返回 message_start、content_block_start/delta/stop、message_delta、message_stop 事件；流内错误发送 error 事件。上游密钥由服务端配置，客户端无需认证。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["user", "assistant"]
                        },
                        "content": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": ["text"]
                                  },
                                  "text": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["type", "text"],
                                "additionalProperties": false
                              },
                              "minItems": 1
                            }
                          ]
                        }
                      },
                      "required": ["role", "content"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "system": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["text"]
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": ["type", "text"],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    ]
                  },
                  "max_tokens": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "stop_sequences": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["model", "messages", "max_tokens"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "非流式 JSON 或 stream=true 时的 SSE。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 事件流；每个事件的数据为协议 JSON，具体事件及结束标记见接口说明。"
                }
              }
            }
          },
          "400": {
            "description": "JSON 解析失败或请求字段不合法。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "502": {
            "description": "上游请求失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
