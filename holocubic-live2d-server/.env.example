OTEL_SERVICE_NAME=holocubic-live2d-server

# OTLP HTTP/JSON base URL; exporters append /v1/traces and /v1/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional authentication: key=value,key2=value2 (do not commit real credentials).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-token
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# OTEL_SDK_DISABLED=true
