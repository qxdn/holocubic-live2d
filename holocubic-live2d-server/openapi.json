{
  "openapi": "3.1.0",
  "info": {
    "title": "HoloCubic Live2D API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "GreetingResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": ["object", "null"],
            "properties": {
              "greeting": {
                "type": "string"
              }
            },
            "required": ["greeting"]
          }
        },
        "required": ["code", "traceId", "success", "message", "data"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api": {
      "get": {
        "operationId": "getGreeting",
        "tags": ["Greeting"],
        "summary": "获取服务问候信息",
        "responses": {
          "200": {
            "description": "统一业务响应，success 表示业务是否成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "tags": ["Chat"],
        "summary": "与测试 Agent 对话，返回 AI SDK UI message 流",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  }
                },
                "required": ["messages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI SDK UI message SSE 流。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
