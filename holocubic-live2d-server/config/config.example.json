{
  "web": {
    "port": 3000
  },
  "websocket": {
    "noServer": true,
    "maxPayload": 65536,
    "perMessageDeflate": false
  },
  "db": {
    "url": "file:../data.db"
  },
  "speech": {
    "vad": {
      "modelPath": "./assets/silero_vad_v6.onnx"
    },
    "asr": {
      "type": "volcengine",
      "options": {
        "apiKey": "your-volcengine-speech-api-key",
        "resourceId": "volc.seedasr.sauc.duration",
        "endpoint": "wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream"
      }
    }
  }
}